# Settings for scripts/deploy-remote.sh and scripts/debrid-gone.sh.
#
# Copy this file to scripts/deploy.env (which git ignores) and fill it in
# for your server. Both scripts run from your local checkout and reach the
# server over SSH, so the host must work with `ssh -o BatchMode=yes`.

# SSH host: an alias from ~/.ssh/config, or user@hostname.
DEPLOY_HOST=my-server

# Folder on the server holding the running decypharr binary, config.json
# and auth.json.
DEPLOY_DIR=/home/me/decypharr

# Scratch folder on the server where deploy-remote.sh unpacks and builds the
# branch before swapping the binary in.
DEPLOY_BUILD_DIR=/home/me/decypharr_build

# decypharr's mount point on the server (deploy-remote.sh checks it after
# the restart).
DEPLOY_MOUNT_PATH=/home/me/mount

# systemd unit that runs decypharr (default decypharr_beta).
#DEPLOY_SERVICE=decypharr
